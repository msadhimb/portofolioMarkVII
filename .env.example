# --- Supabase (list project & experience, lihat supabase/schema.sql) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Fallback lama: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Analytics pengunjung (lihat supabase/analytics_schema.sql) ---
# Service role HANYA untuk server (jangan pernah pakai NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=
# Salt untuk hash IP pengunjung. Isi dengan string acak panjang.
VISIT_HASH_SALT=

# Salin ke .env.local lalu isi sesuai setup Ollama kamu.
# Dibaca server-side oleh src/app/api/chat/route.ts (tidak pernah bocor ke browser).

# URL Ollama — self-host lokal atau server sendiri.
# Contoh lokal: http://localhost:11434
# Contoh server: http://192.168.1.10:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model yang dipakai chatbot (harus sudah di-pull).
# Contoh: llama3.1 | qwen2.5:7b | mistral | gemma2
OLLAMA_MODEL=llama3.1

# API key — WAJIB jika pakai Ollama Cloud (https://ollama.com),
# opsional/kosongkan untuk self-host lokal.
# OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
